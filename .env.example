# GEOTHERM SHIELD: Environment Variables

# Backend Service Port
PORT=8000
HOST=127.0.0.1

# Climate & Meteorological API Endpoints
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Database (PostgreSQL / PostGIS or SQLite Fallback)
DATABASE_URL=sqlite:///./geotherm.db

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
